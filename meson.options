option(
  'profile',
  type: 'combo',
  choices: [
    'default',
    'beta',
    'development',
    'hack',
    'build-env',
  ],
  value: 'default',
  description: 'The build profile for Fractal. One of "default", "beta", "development" or "hack".'
)
option(
  'disable-glycin-sandbox',
  type : 'boolean',
  value : false,
  description: 'Whether the sandbox of glycin should be disabled.' +
               'This is only useful during development.'
)
# Nuntius: label of nightly builds, passed by phosh-toolkit's Flatpak
# workflow (docs/flatpak.md); the development profile already shows
# the commit in the version.
option(
  'build_label',
  type: 'string',
  value: '',
  description: 'Label of a nightly build (branch and commit); unused.'
)
