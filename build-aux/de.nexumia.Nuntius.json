{
    "id": "de.nexumia.Nuntius",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "fractal",
    "finish-args": [
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--share=network",
        "--share=ipc",
        "--device=dri",
        "--talk-name=org.unifiedpush.Distributor.*"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "RUSTFLAGS": "-C link-arg=-fuse-ld=mold --cfg=ruma_identifiers_storage=\"ThinArc\""
        }
    },
    "modules": [
        {
            "name": "grass",
            "buildsystem": "simple",
            "build-options": {
                "env": {
                    "CARGO_HOME": "/run/build/grass/cargo"
                }
            },
            "build-commands": [
                "cargo build --release --offline --locked",
                "install -D ./target/release/grass /app/bin/grass",
                "install -Dm644 -t /app/share/licenses/de.nexumia.Nuntius/grass LICENSE"
            ],
            "cleanup": [
                "/bin/grass"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/connorskees/grass",
                    "tag": "0.13.4",
                    "commit": "e0bb9e2eabfc3a58e42b03089cd7b22c68d09d0b",
                    "disable-submodules": true,
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    }
                },
                "grass-cargo-sources.json"
            ]
        },
        {
            "name": "protobuf-c",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-protoc"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/protobuf-c/protobuf-c.git",
                    "tag": "v1.5.2",
                    "commit": "4719fdd7760624388c2c5b9d6759eb6a47490626",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                }
            ],
            "post-install": [
                "install -Dm644 -t /app/share/licenses/de.nexumia.Nuntius/protobuf-c LICENSE"
            ]
        },
        {
            "name": "libshumate",
            "buildsystem": "meson",
            "config-opts": [
                "--libdir=lib",
                "-Dvapi=false",
                "-Dgtk_doc=false",
                "-Dvector_renderer=true"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/libshumate.git",
                    "tag": "1.7.0",
                    "commit": "e345c805a0dfc46cdbff46cac287b0b60a386f36",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    }
                }
            ],
            "post-install": [
                "install -Dm644 -t /app/share/licenses/de.nexumia.Nuntius/libshumate COPYING"
            ]
        },
        {
            "name": "nuntius",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "../"
                },
                "nuntius-cargo-sources.json",
                {
                    "type": "shell",
                    "commands": [
                        "cat cargo/config >> .cargo/config.toml"
                    ]
                }
            ]
        }
    ]
}
